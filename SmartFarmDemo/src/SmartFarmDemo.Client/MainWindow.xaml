<Window x:Class="SmartFarmDemo.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartFarmDemo.Client"
        Title="SmartFarmDemo" Width="980" Height="640"
        Background="#0E1420" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="SmartFarm" Foreground="#7FB2FF" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="Demo" Foreground="#8FA3C0" FontSize="22" VerticalAlignment="Center" Margin="4,0,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#46D19A" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: sensors + controls -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <Border Background="#16202F" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="온도" Foreground="#8FA3C0" FontSize="12"/>
                            <TextBlock Text="{Binding TempText}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#16202F" CornerRadius="10" Padding="14" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="습도" Foreground="#8FA3C0" FontSize="12"/>
                            <TextBlock Text="{Binding HumText}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#16202F" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="조도" Foreground="#8FA3C0" FontSize="12"/>
                            <TextBlock Text="{Binding LuxText}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="#16202F" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="성장 조명" Foreground="#8FA3C0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LightText}" Foreground="White" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Button Grid.Row="1" Content="{Binding LightText, StringFormat={}{0}}"
                                Command="{Binding ToggleLightCommand}" Height="40" FontSize="15"
                                Background="#4F8CFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock Grid.Row="2" Text="{Binding LastUpdate, StringFormat=업데이트: {0}}"
                                   Foreground="#5D7191" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <Border Background="#16202F" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="온도 추이" Foreground="#8FA3C0" FontSize="12" Margin="0,0,0,4"/>
                        <local:Sparkline Values="{Binding TempSeries}" Stroke="#FF7A59" Height="60"/>
                        <TextBlock Text="조도 추이" Foreground="#8FA3C0" FontSize="12" Margin="0,10,0,4"/>
                        <local:Sparkline Values="{Binding LuxSeries}" Stroke="#FFD166" Height="60"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: camera -->
            <Border Grid.Column="1" Background="#16202F" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="카메라" Foreground="#8FA3C0" FontSize="13" VerticalAlignment="Center"/>
                        <Button Content="촬영" Command="{Binding CapturePhotoCommand}" Height="32" Padding="18,0"
                                Background="#46D19A" Foreground="#0E1420" BorderThickness="0" FontWeight="Bold"
                                HorizontalAlignment="Right" Cursor="Hand"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#0A0F18" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="아직 촬영된 사진이 없습니다" Foreground="#5D7191" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Photo}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
